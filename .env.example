# Copie para .env:  cp .env.example .env
# Os valores padrão funcionam para rodar localmente com Docker.

# MySQL
DB_PASSWORD=brasa_local_troque_me
DB_NAME=brasa_pizzaria_db

# JWT — troque por um valor aleatório antes de qualquer uso fora do local
# (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=troque_esta_chave_em_producao_por_algo_aleatorio

# Senhas dos usuários criados na primeira execução (banco vazio)
#   cozinha@brasa.com → funcionários (tela da cozinha)
#   dono@brasa.com    → dono/gerente (cozinha + gerencial)
SENHA_PADRAO_COZINHA=brasa123
SENHA_PADRAO_DONO=brasa123
